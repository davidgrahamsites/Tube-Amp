(version 1)
(rule "Default clearance" (constraint clearance (min 0.25mm)))
(rule "Tracks" (constraint track_width (min 0.30mm)))
(rule "Board edge" (constraint edge_clearance (min 1.0mm)))
(rule "HV functional copper spacing" (condition "A.NetName == 'B_EARLY' || B.NetName == 'B_EARLY' || A.NetName == 'B_PRE' || B.NetName == 'B_PRE' || A.NetName == 'B_RAW' || B.NetName == 'B_RAW' || A.NetName == 'B_RECT' || B.NetName == 'B_RECT' || A.NetName == 'B_SCREEN' || B.NetName == 'B_SCREEN' || A.NetName == 'HV_A' || B.NetName == 'HV_A' || A.NetName == 'HV_B' || B.NetName == 'HV_B' || A.NetName == 'HV_CAP_MID' || B.NetName == 'HV_CAP_MID' || A.NetName == 'HV_MID_A' || B.NetName == 'HV_MID_A' || A.NetName == 'HV_MID_B' || B.NetName == 'HV_MID_B'") (constraint clearance (min 5.5mm)))
