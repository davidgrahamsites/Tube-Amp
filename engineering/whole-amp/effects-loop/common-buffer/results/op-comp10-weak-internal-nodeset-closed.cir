.options method=gear reltol=0.0001 abstol=1n
VHV hv 0 400
VP vp 0 15
VN vn 0 -15
VIN vin 0 DC 2 AC 1 SIN(2 1.35 1000)
XERR fb inv vp vn err OPAx134
