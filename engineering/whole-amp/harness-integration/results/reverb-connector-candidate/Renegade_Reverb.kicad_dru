(version 1)
(rule "LV copper clearance" (constraint clearance (min 0.25mm)))
(rule "Trace width" (constraint track_width (min 0.30mm)))
(rule "Board edge" (constraint edge_clearance (min 1.0mm)))

(rule "HI008 wet signal width" (condition "A.NetName == 'WET_TOP' || A.NetName == 'WET_W'") (constraint track_width (min 0.60mm)))
(rule "CU002 supply width" (condition "A.NetName == '+15V' || A.NetName == '-15V'") (constraint track_width (min 0.80mm)))
(rule "CU003 relay and driver width" (condition "A.NetName == '+12V' || A.NetName == 'COIL_REV' || A.NetName == 'DRIVER' || A.NetName == 'DRIVE_CAP' || A.NetName == 'TANK_IN'") (constraint track_width (min 0.80mm)))
(rule "CU003 audio width" (condition "A.NetName == 'SEND_BUF' || A.NetName == 'REC_OUT' || A.NetName == 'WET_BUF' || A.NetName == 'SUM_INV' || A.NetName == 'OUT_BUF' || A.NetName == 'OUT_AC'") (constraint track_width (min 0.60mm)))
(rule "CU003 ground local minimum" (condition "A.NetName == 'GND'") (constraint track_width (min 0.30mm)))
