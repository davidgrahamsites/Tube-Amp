(version 1)
(rule "LV copper clearance" (constraint clearance (min 0.25mm)))
(rule "Trace width" (constraint track_width (min 0.30mm)))
(rule "Board edge" (constraint edge_clearance (min 1.0mm)))

(rule "HI008 wet signal width" (condition "A.NetName == 'WET_TOP' || A.NetName == 'WET_W'") (constraint track_width (min 0.60mm)))
