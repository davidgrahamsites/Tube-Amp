HD006 candidate; surrogate MOSFET and regulator; no circuit qualification
VIN IN 0 550
RF IN D 100
RB1 IN RBMID 74850.0
RB2 RBMID GREF 74850.0
RG GREF G 100000
RGH GREF REF 1240000
RGL REF OUT 200000
XREF GREF REF OUT ATL_FLOAT
M1 D G MID MID QPASS
M2 MID G2 S S QPASS2
.model QPASS NMOS LEVEL=1 VTO=-3.5 KP=.4898 LAMBDA=0 RD=.1 RS=.1
CGS G MID 1000p
CGD G D 17p
DB MID D DBODY
.model DBODY D IS=1e-12 RS=.2
RS S REGIN 680
RCIN REGIN CIN 1
CIN CIN OUT 1e-07
BREG REGIN OUT I=max(0,min(.2,min((V(REGIN,OUT)-3)/1,(1.25-V(OUT,ADJ))*1000)))
BIPROG REGIN ADJ I=5e-05*max(0,min(1,V(REGIN,OUT)/3))
RSET OUT ADJ 200
RLOW ADJ 0 43200
COUT OUT 0 0.0001
RHEAT OUT 0 78000


.func if(c,a,b) {c ? a : b}
.func LIMX(x,a,b) {min(max(x,min(a,b)),max(a,b))}
