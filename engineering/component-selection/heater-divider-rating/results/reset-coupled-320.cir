CMON MON 0 1u
DSH 0 MON DSHUNT
.model DSHUNT D IS=1e-12 N=1 RS=1
BSH MON 0 I=max(0,(V(MON)-8.192)/1.5)
BREF MON VR I=max(0,min(.01,(min(2.5,max(0,V(MON)-.2))-V(VR))/.1))
BQUIET MON 0 I=.000097*max(0,min(1,V(MON)/2))
CREF VR 0 .1u
RREFLOAD VR 0 100k
